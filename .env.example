# ikram-meme-and-co — environment contract
# Every variable the code reads. Placeholders only — never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com,second-admin@example.com   # comma-separated admin allowlist

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key            # server-only, never NEXT_PUBLIC

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
